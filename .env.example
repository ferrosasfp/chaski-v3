# Chaski v2 — variables de entorno. Copiá a .env.local y completá.
# NADA de secrets en el repo: este archivo solo documenta las claves.

# ── KYC (Didit) ──────────────────────────────────────────────────────────────
# Sacá el API key GRATIS en https://business.didit.me (500 verificaciones/mes gratis, para
# siempre; sandbox desde el minuto uno, no consume cuota). El key vive SOLO server-side.
DIDIT_API_KEY=
# UUID del workflow (lo creás en la Didit Console: ID Verification + Liveness + Face Match + AML).
DIDIT_WORKFLOW_ID=
# Opcional — default https://verification.didit.me
DIDIT_BASE_URL=

# ── Prod-detection (WKH-180) ──
# VERCEL_ENV lo inyecta Vercel automáticamente ("production" solo en el deploy de prod).
# /api/payout/validate lo usa para fail-loud en prod sin DIDIT_API_KEY (nunca autoriza por default).
# Fuera de Vercel (self-host/CI) VERCEL_ENV está ausente → camino simulado; seteá DIDIT_API_KEY
# para re-validar de verdad. NO requiere env var nueva.

# [DEPRECATED — no-op desde WKH-180] Ya NO se lee en ningún lado de src/. El server
# decide el adapter KYC (DiditKycGateway con fallback interno). Se deja documentada
# para el historial; setearla no tiene efecto.
NEXT_PUBLIC_KYC_MODE=

# ── KYC — auth de sesión (WKH-179) ──
# Secreto HMAC para firmar el token de sesión (x-kyc-token). Obligatorio cuando DIDIT_API_KEY está seteado.
KYC_SESSION_SECRET=
# Base URL server-side para el callback a Didit (M6). Si vacío → sesión sin callback (Didit default; el resume anda por localStorage).
KYC_CALLBACK_BASE_URL=

# ── Rate-limit (Upstash Redis, WKH-179) ── Obligatorias cuando DIDIT_API_KEY está seteado (prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Overrides opcionales (defaults: 5/"10 m" por IP, 3/"10 m" por address).
KYC_RL_IP_MAX=
KYC_RL_IP_WINDOW=
KYC_RL_ADDR_MAX=
KYC_RL_ADDR_WINDOW=

# Rate-limit /api/payout/validate (WKH-205) — cada POST re-consulta Didit (costo Chaski). Solo se
# aplica cuando DIDIT_API_KEY está seteado (prod-like). Defaults: 5/"10 m" por IP, 3/"10 m" por address.
PAYOUT_VALIDATE_RL_IP_MAX=
PAYOUT_VALIDATE_RL_IP_WINDOW=
PAYOUT_VALIDATE_RL_ADDR_MAX=
PAYOUT_VALIDATE_RL_ADDR_WINDOW=

# Rate-limit /api/a2a/payout/challenge (WKH-205) — CPU-DoS del HMAC. IP-only (el body no se parsea aún).
# Solo se aplica cuando PAYOUT_POP_SECRET está seteado. Default: 10/"10 m" por IP.
PAYOUT_CHALLENGE_RL_IP_MAX=
PAYOUT_CHALLENGE_RL_IP_WINDOW=

# ── Chain (WKH-182 / WKH-209) ────────────────────────────────────────────────
# ChainId de la red donde el sender firma/opera. ÚNICA fuente para AMBOS adapters de wallet
# (InjectedWallet + WalletConnect). Solo Base mainnet (8453) / Base Sepolia (84532) soportados;
# unset o cualquier otra cosa → 84532 (fail-safe = Base Sepolia testnet, jamás mainnet real).
# El settle del principal (EIP-3009) liquida en Base porque TransFi (payout) desembolsa USDC en Base.
# Flipear a 8453 (mainnet) queda atado a EIP-3009 real + aprobación ops. Es NEXT_PUBLIC (lo lee el cliente).
NEXT_PUBLIC_CHAIN_ID=

# ── VM activa (WKH-206 / HU-SOL-1) ───────────────────────────────────────────
# Selecciona la máquina virtual de settlement. ORTOGONAL a NEXT_PUBLIC_CHAIN_ID (que sigue EVM-only).
# unset/"evm" (default fail-safe) → path EVM byte-idéntico. "solana" → rama Solana devnet (config+tipos,
# SIN wiring runtime en esta HU — HU-SOL-2/SOL-4). Cualquier otro valor → fail-loud (throw unsupported_vm).
NEXT_PUBLIC_VM=
# Mint USDC de Solana (base58). ÚNICA fuente (no se hardcodea). Canónico devnet de Circle:
# 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU. Se valida con PublicKey de @solana/web3.js; sin él →
# resolveSolanaUsdcMint() lanza solana_usdc_mint_not_configured. Es NEXT_PUBLIC (lo lee el cliente).
NEXT_PUBLIC_SOLANA_USDC_MINT=
# RPC READ-ONLY de Solana devnet (server-only, SIN NEXT_PUBLIC_). Default público sugerido:
# https://api.devnet.solana.com. Sin él → resolveSolanaRpcUrl() devuelve undefined (el caller fail-closea).
SOLANA_DEVNET_RPC_URL=
# RPC público CLIENT-SAFE de Solana (OPCIONAL, NEXT_PUBLIC_ → lo lee el bundle browser). Lo usa el
# adapter Solana client-side (authorizePrincipal) para leer el blockhash. Sin él → fallback fail-soft
# al endpoint público de la lib (clusterApiUrl(cluster), p.ej. https://api.devnet.solana.com). Setealo
# a un RPC dedicado (Helius/Triton/…) para evitar el rate-limit del público (AR-MNR-2).
NEXT_PUBLIC_SOLANA_RPC_URL=
# Pubkey base58 de la RELEASE-AUTHORITY del escrow Solana no-custodial (server-only, SIN NEXT_PUBLIC_,
# CD-4). La keypair PRIVADA correspondiente vive SOLO en el facilitator (firma el release), NUNCA en
# chaski — acá solo el PUBKEY. La lee chain.ts:179; /api/payout/prepare Solana la EXIGE: ausente o
# malformada ⇒ 503 prepare_solana_authority_unavailable (fail-loud, HU-SOL-11). Se valida con PublicKey
# de @solana/web3.js (base58), nunca isAddress de viem.
SOLANA_ESCROW_RELEASE_AUTHORITY_PUBKEY=
# Pubkey base58 del fee-payer del facilitator (gasless). Client-safe (NEXT_PUBLIC_ → lo lee el bundle).
# La lee chain.ts:162; con NEXT_PUBLIC_SOLANA_SETTLE_ENABLED=true el guard del container la exige
# fail-loud (la app no arranca sin ella cuando el settle Solana está on). Se valida con PublicKey (base58).
NEXT_PUBLIC_SOLANA_FACILITATOR_PUBKEY=
# "true" enciende el path Solana settle (deposit + sponsor gasless). La leen container.ts:102 y
# solana-sponsor/route.ts:22. Default OFF ⇒ byte-idéntico (/api/settle/solana-sponsor responde 501).
# ⚠️ NO encender en ningún entorno compartido (CD-5): esta HU CONSTRUYE, NO ENCIENDE.
NEXT_PUBLIC_SOLANA_SETTLE_ENABLED=

# ── Wallet (WalletConnect / Reown) ──
# Project ID de Reown/WalletConnect (https://cloud.reown.com). Habilita el adapter WalletConnect
# (deep-link a la wallet en móvil) cuando NO hay wallet inyectada. Sin él → wallet inyectada o demo.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ── Value-delivery scaffolding (WKH-186) ── TODO mock/off por DEFAULT (CD-2): ningún default mueve
# plata real. Se encienden juntos en Fase A (creds TransFi reales) — el guard del container fuerza
# la coherencia (EIP-3009 real exige adapter=a2a + receiver + usdc, si no la app NO arranca).
#
# Adapter de quote+payout. unset/"fallback" (default) → Fallback gateways (demo, payout MOCK).
# "a2a" → llama a los agentes remit-corridor-fx/remit-cashout-payout vía las API routes server-only.
NEXT_PUBLIC_VALUE_DELIVERY_ADAPTER=
# Base URL de los agentes remit-* (server-only, SIN NEXT_PUBLIC_ — nunca llega al cliente, CD-9).
# Sin base → las rutas /api/a2a/* devuelven 501. Las rutas invocan {BASE}/api/agents/<slug>/invoke.
#
# ⚠️ ACOPLAMIENTO con DIDIT_API_KEY (gate WKH-202). /api/a2a/payout/submit re-valida server-side
# contra Didit (KYC Approved + ownership del address vs vendor_data) ANTES de forwardear el submit
# al agente. Sin DIDIT_API_KEY la autoridad SIMULA (rama simulated_dev) y el submit la RECHAZA con
# 503 en cualquier scope de Vercel → el payout NO funciona. Por eso: NO setear REMIT_AGENTS_BASE_URL
# en ningún scope de Vercel (preview incluido) donde DIDIT_API_KEY esté ausente — se setean JUNTAS.
#
# Además, cerrar WKH-202 NO habilita por sí solo la Fase A: falta WKH-203 (kycPayoutAllowed
# re-derivado server-side en el agente, hoy es un booleano del caller) y WKH-168 (verificación de
# que el sender pagó el principal en USDC).
REMIT_AGENTS_BASE_URL=
# --- A2A Gateway (WKH-218) — modo de transporte "a2a-gateway" (default OFF: construye, no enciende) ---
# Server-only (SIN NEXT_PUBLIC_): nunca llegan al bundle browser (CD-3/AC-7).
# WASIAI_A2A_GATEWAY_URL=https://<gateway>            # base del gateway wasiai-a2a (POST /discover + /compose)
# WASIAI_A2A_AGENT_KEY=<agent-key>                    # Agent Key prepaga propia de Chaski (header x-a2a-key)
# WASIAI_A2A_FX_CAPABILITY=fx-quote                   # capability del remit-corridor-fx (ajustar al AgentCard real)
# WASIAI_A2A_PAYOUT_CAPABILITY=cashout-payout         # capability del remit-cashout-payout (ajustar al AgentCard real)
# WASIAI_A2A_FX_SLUG=remit-corridor-fx                # opcional: desambigua el pick del discover
# WASIAI_A2A_PAYOUT_SLUG=remit-cashout-payout         # opcional: desambigua el pick del discover
# NEXT_PUBLIC_VALUE_DELIVERY_ADAPTER=a2a-gateway      # 3er valor (además de "fallback"|"a2a")
# NOTA (DT-A2A-9): en modo gateway el payout SIGUE exigiendo REMIT_AGENTS_BASE_URL seteada
#   (guard 1 byte-idéntico), aunque el forward ya no la use para el transporte. Setéalas juntas.
# Firma REAL EIP-3009 (transferWithAuthorization) del principal. unset/"false" (default) →
# authorizePrincipal firma un mensaje simbólico (byte-idéntico al demo). "true" → firma EIP-712 real;
# EXIGE NEXT_PUBLIC_VALUE_DELIVERY_ADAPTER=a2a + receiver + usdc (guard fail-loud en el container).
NEXT_PUBLIC_EIP3009_ENABLED=
# Address que RECIBE el principal en la firma EIP-3009 (el "to" del transferWithAuthorization).
# Sin ella → el guard del container lanza si EIP-3009 está on. Sin efecto con EIP-3009 off.
NEXT_PUBLIC_PAYOUT_RECEIVER_ADDRESS=
# Contrato USDC para el domain EIP-712 de la firma (verifyingContract). ÚNICA fuente (no se
# hardcodea). Canónico de Circle: Base mainnet (8453) = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
# Base Sepolia (84532) = 0x036CbD53842c5426634e7929541eC2318f3dCF7e. Sin él → guard lanza si EIP-3009 on.
# ⚠️ CD-4: el domain EIP-712 name difiere por red (Base Sepolia="USDC", Base mainnet="USD Coin") —
# lo deriva chain.ts de la tabla NETWORKS; esta env solo fija el verifyingContract (address).
#
# ⚠️ WKH-168: DEBE ser el USDC canónico de la chain. El facilitator lo HARDCODEA por cadena y rechaza
# (400) si accepted.asset no coincide → TODO settle falla. Fail-closed (no se pierde plata) pero es
# config-drift silencioso (precedente WKH-162).
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=

# ── Settlement REAL del principal (WKH-168) ── Las 4 son SERVER-ONLY: NINGUNA lleva NEXT_PUBLIC_
# (CD-4: una credencial con ese prefijo se inlinea en el bundle del cliente).
# ⚠️ Nada de esto se enciende solo: sigue gateado por NEXT_PUBLIC_EIP3009_ENABLED (OFF por default,
# CD-1). Esta HU CONSTRUYE, NO ENCIENDE.
#
# Base URL del wasiai-facilitator (transmite el transferWithAuthorization firmado). Sin ella →
# /api/settle/principal responde 501. Es el ÚNICO servicio que broadcastea (CD-20).
FACILITATOR_BASE_URL=
# Bearer del facilitator. NUNCA llega al cliente (la ruta server-side es la única que lo usa).
# ⚠️ FACILITATOR_PAYTO_ALLOWLIST **del facilitator** DEBE incluir nuestro
# NEXT_PUBLIC_PAYOUT_RECEIVER_ADDRESS, o TODO settle da 403 (→ nuestro 502 settle_rejected).
# ⚠️ Un facilitator sin FACILITATOR_API_KEY/API_KEYS configuradas NO autentica: verificar antes de encender.
FACILITATOR_API_KEY=
# RPC READ-ONLY para la verificación on-chain independiente (DT-5). Es lo que hace que principal_in
# signifique "el USDC llegó" y no "el usuario firmó": leemos el receipt + el log Transfer del USDC
# nosotros mismos (la respuesta del facilitator es un ECO de nuestro input, no una verificación).
# Sin ella → 503 fail-closed: sin poder verificar, NO se atestigua. Preferir un RPC dedicado: uno
# público puede rate-limitear → 503 con el principal ya adentro (varado → WKH-207).
# WKH-209: se lee el RPC de la red ACTIVA (resolveRpcUrl() en chain.ts elige por NEXT_PUBLIC_CHAIN_ID).
# Base Sepolia (84532, default) usa BASE_SEPOLIA_RPC_URL; Base mainnet (8453) usa BASE_MAINNET_RPC_URL.
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
# Secreto HMAC de la atestación de settlement (lo que ata el payout al USDC realmente recibido).
# Sin él, en un deploy de Vercel /api/a2a/payout/submit responde 503 (nunca fail-open). Fuera de
# Vercel (local/CI) la exigencia no aplica → el demo local sigue andando.
# ⚠️ El gate también EXIGE UPSTASH_REDIS_REST_URL/TOKEN (ya arriba): son el single-use anti-replay de
# la atestación. Sin ellas el submit responde 503 (fail-closed).
SETTLE_ATTESTATION_SECRET=

# ── Value-delivery no-custodial: DepositAddress binding (WKH-211) ── SERVER-ONLY (SIN NEXT_PUBLIC_,
# CD-4). Secreto HMAC NUEVO y SEPARADO de SETTLE_ATTESTATION_SECRET (dominios distintos pre/post-
# settlement, DT-4 — jamás compartir). Su PRESENCIA habilita el guard deposit-flow de
# /api/settle/principal (B1-B6: el `to` de la firma se ata al depositAddress atestado por remesa, ya no
# al receiver estático) + el endpoint /api/payout/prepare (que crea la orden TransFi y emite el binding
# ANTES de la firma). Ausente → /api/settle/principal corre en modo estático BYTE-IDÉNTICO a WKH-209 y
# /api/payout/prepare responde 503 (fail-closed, nunca fail-open).
# ⚠️ Esta HU CONSTRUYE, NO ENCIENDE (CD-1/CD-4): sigue gateado por NEXT_PUBLIC_EIP3009_ENABLED (OFF por
# default). El depositAddress REAL (no-null) exige el agente con TRANSFI_ADAPTER_READY=true (repo
# wasiai-remittance-agents, cross-repo WKH-212); con el agente en mock devuelve null → prepare
# fail-closed (prepare_no_deposit_address). NO encender en ningún entorno compartido.
DEPOSIT_ATTESTATION_SECRET=

# ── Proof-of-Possession del payout (WKH-206) ── Doble-flag coordinado (idéntico patrón que EIP-3009):
# la presencia del secreto SERVER-ONLY habilita el guard; un flag NEXT_PUBLIC_ separado enciende el
# cliente. Esta HU CONSTRUYE, NO ENCIENDE (ambos OFF por default = demo byte-idéntico).
#
# Secreto HMAC server-only (SIN NEXT_PUBLIC_ — CD-4: nunca llega al bundle del cliente). Su PRESENCIA
# habilita el guard de proof-of-possession en /api/a2a/payout/submit: exige que el body traiga un
# popChallenge + popSignature válidos (el firmante recuperado == address). /api/a2a/payout/challenge
# lo usa para emitir/firmar el challenge. Ausente → /challenge responde 501 y el submit NO exige PoP.
PAYOUT_POP_SECRET=
# Flag del CLIENTE (el browser NO puede ver PAYOUT_POP_SECRET, necesita su propia señal). "true" → el
# cliente fetchea /api/a2a/payout/challenge, firma el popMessage con la wallet y adjunta
# popChallenge/popSignature al submit. unset/"false" (default) → NO fetchea ni firma (demo byte-idéntico).
#
# ⚠️ ACOPLAMIENTO ops: hay que encender AMBOS. server-ON (secreto presente) + cliente-OFF ⇒ el body no
# trae la prueba → el submit responde 403 y el payout FALLA. ambos-OFF (default) ⇒ demo byte-idéntico.
# server-OFF + cliente-ON ⇒ /challenge responde 501; el cliente lo trata como skip (no adjunta campos).
NEXT_PUBLIC_PAYOUT_POP_ENABLED=

# ── Settlement ledger + reconciliación (WKH-207) ── Persistencia server-side de la evidencia
# money-path (Supabase PROPIO de chaski-v2, NUNCA la DB de wasiai-a2a — CD-10). CONSTRUYE, NO ENCIENDE:
# sin flag y/o sin envs → getSettlementLedger() devuelve null → las rutas skipean el persist →
# byte-idéntico a hoy (AC-2/AC-10). La migración se entrega PENDING-DEPLOY (no aplicada, CD-1).
# Todas server-only (SIN NEXT_PUBLIC_): nunca llegan al bundle del cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SETTLEMENT_LEDGER_ENABLED=            # "true" para encender (default OFF = byte-idéntico, CD-2)
RECONCILE_ADMIN_SECRET=              # ausente ⇒ /api/admin/reconcile-orphans responde 501 (CD-8)
RECONCILE_STALE_THRESHOLD_SECONDS=   # default 900 (15 min): antigüedad para considerar una remesa varada
# Secreto del webhook de TransFi (WKH-210) para verificar el HMAC-SHA256 entrante sobre el body crudo.
# Server-only (SIN NEXT_PUBLIC_). Ausente ⇒ POST /api/webhooks/transfi responde 501 (fail-closed, CD-2).
TRANSFI_WEBHOOK_SECRET=

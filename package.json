{
  "name": "chaski-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chaski — DApp de remesas no custodiales sobre Solana (USDC→PEN→Yape). Escrow Anchor en devnet, prueba de posesión ed25519, gas patrocinado. Clean Architecture.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint src app scripts",
    "lint:fix": "biome lint --write src app scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run src/domain src/application",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "smoke:solana": "tsx scripts/smoke-solana-e2e.ts",
    "qa": "npm run lint && npm run typecheck && npm run typecheck:scripts && npm run test"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/wallet-adapter-wallets": "0.19.38",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.59.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "bs58": "6.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.446.0",
    "next": "^16.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.2",
    "tweetnacl": "1.0.3",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
